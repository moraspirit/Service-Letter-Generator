# Reverse proxy + automatic HTTPS for the dev-test deployment (architecture §9:
# "HTTPS everywhere"). No domain was available for this round, so this uses
# sslip.io, a free service that resolves "<ip-with-dashes>.sslip.io" to that
# same IP — which is enough for Caddy to complete a real Let's Encrypt HTTP-01
# challenge and get a trusted certificate without owning a domain.
#
# Replace VPS_IP_WITH_DASHES before first run, e.g. 203.0.113.5 -> 203-0-113-5.
VPS_IP_WITH_DASHES.sslip.io {
	reverse_proxy issuance:3000
}
