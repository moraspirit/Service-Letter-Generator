# apps/verify/.env.local — the public verification app (Vercel).
# Copy to `.env.local` and fill in. Never commit the real file.
#
# This app is read-only by design. It must never hold the read/write database
# credentials, an AUTH_SECRET, or any Inngest key — if a variable here would let
# it write something, it does not belong in this app (architecture §1, §3).

# ---------------------------------------------------------------------------
# Database — SELECT-only user (architecture §3)
# ---------------------------------------------------------------------------
# `verify_ro` may read templates, template_versions and certificates, and
# nothing else. Created in P0-09.
#
# connection_limit=1: the verify page is not cached, so every scan is a live
# query and each serverless instance must hold as few connections as possible
# (architecture §3, §6 D).
DATABASE_URL="mysql://verify_ro:PASSWORD@mysql-1834a754-dineth75nimsara75-d840.k.aivencloud.com:28605/mora-spirit?connection_limit=1&pool_timeout=10"

# Aiven's private CA. On Vercel there is no filesystem to read a PEM from, so
# use the base64 form here — this is why both apps take the certificate the same
# way rather than as a file path.
#   Git Bash / Linux :  base64 -w0 .certs/ca.pem
#   PowerShell       :  [Convert]::ToBase64String([IO.File]::ReadAllBytes(".certs/ca.pem"))
DB_CA_CERT_B64=""
DB_CA_CERT_PATH="../../.cert/ca.pem"

# ---------------------------------------------------------------------------
# Public rate limiting (Phase 7)
# ---------------------------------------------------------------------------
# Upstash Redis, 60 requests/minute/IP on /verify/*. Rate limiting fails open:
# if these are unset or Upstash is unreachable, requests are allowed through —
# verification must never go down because Redis is unavailable (architecture §9).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
