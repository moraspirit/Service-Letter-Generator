# apps/issuance/.env.local — the admin app (VPS, Docker).
# Copy to `.env.local` and fill in. Never commit the real file.

# ---------------------------------------------------------------------------
# Database — read/write user (architecture §3)
# ---------------------------------------------------------------------------
# Owns all writes and migrations. Until P0-08 creates `app_rw`, use `avnadmin`.
DATABASE_URL="mysql://app_rw:PASSWORD@mysql-1834a754-dineth75nimsara75-d840.k.aivencloud.com:28605/mora-spirit"

# Aiven signs certificates with its own private CA, so the TLS connection can
# only be verified if that CA is supplied. Set ONE of these:
#
#   DB_CA_CERT_B64   base64 of .certs/ca.pem — works everywhere, including
#                    Vercel and Docker, and survives single-line env files.
#   DB_CA_CERT_PATH  path to the PEM file — convenient locally and on the VPS.
#
# B64 wins if both are set. Generate it with:
#   Git Bash / Linux :  base64 -w0 .certs/ca.pem
#   PowerShell       :  [Convert]::ToBase64String([IO.File]::ReadAllBytes(".certs/ca.pem"))
DB_CA_CERT_B64=""
DB_CA_CERT_PATH="../../.certs/ca.pem"

# ---------------------------------------------------------------------------
# Auth (Phase 2)
# ---------------------------------------------------------------------------
# Session signing secret. Generate a fresh one per environment:
#   openssl rand -base64 32
AUTH_SECRET=""

# ---------------------------------------------------------------------------
# Certificate rendering (Phase 3)
# ---------------------------------------------------------------------------
# Public origin of the verification app. This is baked into every QR code, so
# it must be the final public domain before any real certificate is issued —
# printed QR codes cannot be changed afterwards.
VERIFY_BASE_URL="http://localhost:3001"

# ---------------------------------------------------------------------------
# Background jobs (Phase 6)
# ---------------------------------------------------------------------------
INNGEST_EVENT_KEY=""
INNGEST_SIGNING_KEY=""

# Where bulk ZIP exports are written. A Docker volume in production; must not be
# served as a public static folder. Files are deleted 24 h after generation.
EXPORT_DIR="../../.data/tmp-exports"
