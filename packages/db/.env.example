# packages/db/.env.local — used by the Prisma CLI only (migrations, generate, studio).
# Copy to `.env.local` in this folder and fill in. Never commit the real file.
#
# Uses the read/write user: migrations are owned solely by the issuance side
# (architecture §3). The verification app never runs them.

# Aiven (development). Host, port and database from the service Overview page.
#   - Until P0-08 creates `app_rw`, use the `avnadmin` user Aiven gave you.
#   - `sslaccept=strict` verifies the server certificate; `sslcert` points at
#     Aiven's private CA so that verification can succeed. Prisma's migration
#     engine is a Rust binary using the OS trust store, so NODE_EXTRA_CA_CERTS
#     does NOT affect it — the CA must be passed in the URL.
#     The path is relative to packages/db, where the Prisma CLI runs.
DATABASE_URL="mysql://avnadmin:PASSWORD@mysql-1834a754-dineth75nimsara75-d840.k.aivencloud.com:28605/mora-spirit?sslaccept=strict&sslcert=../../.cert/ca.pem"

# Path to the Aiven CA certificate (Console → service Overview → CA certificate
# → Show, saved as .certs/ca.pem). Node adds it to its trust store, which is how
# `sslaccept=strict` can verify a privately-signed certificate.
# Relative paths resolve from wherever the command runs, so an absolute path is
# safer on Windows.
NODE_EXTRA_CA_CERTS="../../.cert/ca.pem"
