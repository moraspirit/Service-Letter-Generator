{
  "name": "@moraspirit/db",
  "version": "0.0.0",
  "private": true,
  "description": "Prisma schema, migrations and generated client \u2014 the only place database access is defined",
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "studio": "prisma studio",
    "validate": "prisma validate",
    "format:schema": "prisma format",
    "seed": "node prisma/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "dotenv": "^18.0.0",
    "prisma": "7.10.0",
    "@types/node": "^20.19.43"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "mariadb": "^3.5.4"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  }
