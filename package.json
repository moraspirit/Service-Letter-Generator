{
  "name": "moraspirit-certificates",
  "version": "0.0.0",
  "private": true,
  "description": "Certificate issuance and QR verification system for MoraSpirit",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:seed": "pnpm --filter @moraspirit/db seed",
    "db:reset": "pnpm --filter @moraspirit/db exec prisma migrate reset"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.8",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
